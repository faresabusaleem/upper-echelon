# Copy to .env.local for local development (values below match `npx supabase start`).
# In production set these in Vercel → Project → Settings → Environment Variables.

# Public
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Cloudflare Turnstile. The default is Cloudflare's always-pass test key; use your own in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Show "Continue with Google" only once Google OAuth is configured in Supabase.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
# Match Supabase Auth's "Confirm email" setting ("false" when it is switched off), so the join form
# does not promise a confirmation letter that will not be sent.
NEXT_PUBLIC_EMAIL_CONFIRMATION=true

# Server only
SUPABASE_SECRET_KEY=sb_secret_xxx
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Random string; Vercel sends it as a Bearer token to /api/cron/daily.
CRON_SECRET=change-me-to-a-long-random-string
# Random string used to hash IP addresses for sign-up rate limiting (IPs are never stored).
IP_HASH_SALT=change-me-too
# Optional SMTP for notification emails (Brevo free tier works). Locally, Mailpit on 54325.
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM="Upper Echelon <no-reply@upper-echelon.local>"
# Address shown on the contact page and in legal documents.
CONTACT_EMAIL=
